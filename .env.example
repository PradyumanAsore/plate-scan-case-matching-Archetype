# Plate Scan & Case Matching Service - Environment Variables
# Copy to .env and fill in real values

# PostgreSQL
POSTGRES_USER=platescan
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=platescan
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://platescan:changeme_in_production@db:5432/platescan

# JWT
JWT_SECRET_KEY=changeme_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Backend
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ELIGIBILITY_SERVICE_URL=http://localhost:8000/mock/partner-network/eligibility
ELIGIBILITY_TIMEOUT_SECONDS=5

# Frontend
VITE_API_BASE_URL=http://localhost:8000
